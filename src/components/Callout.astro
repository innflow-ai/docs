---
import { Aside } from '@astrojs/starlight/components';
interface Props { type?: 'info' | 'warning' | 'tip' | 'danger'; title?: string }
const { type = 'info', title } = Astro.props;
---
<Aside type={type === 'info' ? 'note' : type === 'warning' ? 'caution' : type} title={title}><slot /></Aside>
